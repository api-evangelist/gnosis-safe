{
  "opencollection": "1.0.0",
  "info": {
    "name": "Safe Transaction Service 4337 tokens API",
    "version": "6.3.0"
  },
  "items": [
    {
      "info": {
        "name": "tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "tokens_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/tx-service/eth/api/v1/tokens/",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "address",
                "value": "",
                "type": "query"
              },
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "decimals__lt",
                "value": "",
                "type": "query"
              },
              {
                "name": "decimals__gt",
                "value": "",
                "type": "query"
              },
              {
                "name": "decimals",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "A search term."
              },
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Which field to use when ordering the results."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Returns the list of tokens supported in the Safe Transaction Service"
        },
        {
          "info": {
            "name": "tokens_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/tx-service/eth/api/v1/tokens/:address/",
            "params": [
              {
                "name": "address",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Returns detailed information on a given token supported in the Safe Transaction Service"
        },
        {
          "info": {
            "name": "tokens_lists_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/tx-service/eth/api/v1/tokens/lists/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Returns the list of tokens supported in the Safe Transaction Service"
        }
      ]
    }
  ],
  "bundled": true
}